# Copy to .env and fill in the two API keys. Everything else has a working default.

# --- AI: any OpenAI-compatible endpoint (OpenAI itself or a LiteLLM proxy) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RECOGNITION_MODEL=gpt-5-mini
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# --- Market data: free key from https://finnhub.io ---
FINNHUB_API_KEY=

# --- Quota ---
QUOTA_DAILY_TOKENS=500000
QUOTA_RESERVATION_TOKENS=20000
QUOTA_MAX_ACTIVE_ANALYSES=3

# --- Local development against `docker compose up -d postgres redis rabbitmq` ---
# (inside docker compose these are overridden with the service hostnames)
DATABASE_URL=postgresql+asyncpg://chart:chart@localhost:55432/chart_analyzer
REDIS_URL=redis://localhost:56379/0
RABBITMQ_URL=amqp://chart:chart@localhost:55672/
UPLOAD_DIR=uploads
LOG_JSON=true
LOG_LEVEL=INFO
